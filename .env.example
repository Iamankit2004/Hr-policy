# PolicyPilot environment configuration
# Copy this file to .env and fill in the values for your environment.
# Never commit a real .env file — it is already git-ignored.

# --- LLM / Embedding provider -------------------------------------------
# PolicyPilot talks to any OpenAI-compatible chat + embeddings API. Point
# LLM_BASE_URL / EMBEDDING_BASE_URL at any compatible provider (OpenAI,
# OpenRouter, Groq, Gemini's OpenAI-compat endpoint, a local OpenAI-compatible
# server, etc.) and the app works unmodified.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# If your embedding provider differs from your LLM provider, set these too.
# Otherwise they default to OpenAI's embeddings endpoint.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval / grounding -----------------------------------------------
# Minimum cosine similarity for a chunk to be considered at all.
SIMILARITY_THRESHOLD=0.32
# Minimum similarity for at least one chunk before the LLM is even called.
# Below this, PolicyPilot returns the safe refusal without an LLM call.
STRONG_SIMILARITY_THRESHOLD=0.4

# --- Database / vector store ----------------------------------------------
# PolicyPilot uses Supabase Postgres (with pgvector) for both document
# metadata and embeddings — see supabase/migrations for the schema.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
